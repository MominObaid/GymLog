<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/streak_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/outline_trophy_24"
            android:contentDescription="Streak" />

        <TextView
            android:id="@+id/widgetStreakText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="-- Streak"
            android:textStyle="bold"
            android:textColor="#FF8F00"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetTodayWorkout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/streak_layout"
        android:layout_marginTop="8dp"
        android:text="Ready to train?"
        android:textColor="#1C1B1F"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetSubText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widgetTodayWorkout"
        android:text="Open GymLog to start"
        android:textColor="#49454F"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widgetBtnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/widget_button_background"
        android:gravity="center"
        android:padding="10dp"
        android:text="Start Workout"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</RelativeLayout>
